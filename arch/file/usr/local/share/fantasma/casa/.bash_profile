# Utente fantasma (creato da vetro-arch.sh): tutto quello che fai qui sta solo in memoria
# e sparisce allo spegnimento. Internet passa tutto da Tor (modalita' fantasma), l'ora
# dei programmi e' quella universale (UTC) e i comandi scritti non vengono ricordati.
# Il desktop lo avvia la schermata di accesso (avvia-desktop accende prima la modalita').
export PATH="/usr/local/bin:$PATH"
export TZ=UTC
export HISTFILE=/dev/null
