#!/bin/sh
# Sfondo del desktop (creato da vetro-arch.sh). Si sceglie da Impostazioni -> Aspetto (la
# scelta e' in ~/.config/sfondo.conf). In oversicaOS lo sfondo lo gestisce Caelestia:
# questo serve solo come riserva (swaybg).
#   sfondo-desktop              mette lo sfondo (nel desktop Vetro lo disegnano i pannelli)
#   sfondo-desktop --percorso   scrive solo quale immagine usare
#   sfondo-desktop --swaybg     lo mette comunque con swaybg
img=$(sed -n 's/^SFONDO=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/sfondo.conf" 2>/dev/null | head -n1)
[ -n "$img" ] && [ -f "$img" ] || img=/usr/share/backgrounds/oversica-grafite.jpg
if [ "${1:-}" = --percorso ]; then
  echo "$img"
  exit 0
fi
# oversicaOS: lo sfondo lo disegna Caelestia (si sceglie dal suo menu o da Impostazioni)
if [ "${1:-}" != --swaybg ] && pgrep -u "$(id -u)" -x Hyprland >/dev/null 2>&1 \
   && qs -c caelestia ipc call oversica ping >/dev/null 2>&1; then
  pkill -u "$(id -u)" -x swaybg
  exit 0
fi
pkill -u "$(id -u)" -x swaybg
exec swaybg -i "$img" -m fill
