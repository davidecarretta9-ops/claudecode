#!/bin/bash
# Avvia il desktop Vetro (creato da vetro-arch.sh): Hyprland con i pannelli Quickshell.
# Lo lancia la schermata di accesso (greetd) dopo la password giusta.
# Il registro di Hyprland e' in ~/.cache/hyprland.log (quello della volta prima in
# ~/.cache/hyprland-prima.log).
export PATH="/usr/local/bin:$PATH"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONF/hypr" "$CONF/vetro" "$HOME/.cache"
[ -f "$CONF/hypr/personale.conf" ] || printf '# Le tue modifiche a Hyprland (le legge per ultime)\n' > "$CONF/hypr/personale.conf"
[ -f "$CONF/hypr/vetro-impostazioni.conf" ] || cp /etc/xdg/hypr/vetro-impostazioni.conf "$CONF/hypr/vetro-impostazioni.conf"
# risoluzione di partenza: nelle macchine virtuali 1920x1080 (all'accensione QEMU
# propone spesso 800x600). Quella scelta in Impostazioni -> Schermo vale su tutte
# (e' scritta dopo, in vetro-impostazioni.conf)
if systemd-detect-virt -q 2>/dev/null; then
    echo "monitor = , 1920x1080, auto, 1" > "$CONF/hypr/vetro-schermo.conf"
else
    echo "# su un PC vero: la risoluzione migliore dello schermo (vetro.conf)" > "$CONF/hypr/vetro-schermo.conf"
fi
if [ -f "$HOME/.cache/hyprland.log" ]; then mv -f "$HOME/.cache/hyprland.log" "$HOME/.cache/hyprland-prima.log"; fi
exec Hyprland -c /etc/xdg/hypr/vetro.conf > "$HOME/.cache/hyprland.log" 2>&1
