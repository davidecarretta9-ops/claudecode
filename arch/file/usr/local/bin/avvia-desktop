#!/bin/bash
# Avvia il desktop Vetro (creato da lfs.sh): Hyprland con i pannelli Quickshell.
# Lo lancia la schermata di accesso (greetd) dopo la password giusta.
# Il registro di Hyprland e' in ~/.cache/hyprland.log (quello della volta prima in
# ~/.cache/hyprland-prima.log).
export PATH="/usr/local/bin:$PATH"
# l'utente fantasma: prima la modalita' fantasma (tutto da Tor); se non si accende il
# desktop non parte (per sicurezza) e si torna alla schermata di accesso
if [ "$(id -un)" = fantasma ]; then
    export TZ=UTC HISTFILE=/dev/null
    if ! sudo -n /usr/local/sbin/fantasma-aiuto accendi; then
        echo "Non riesco ad accendere la modalita' fantasma: per sicurezza il desktop non parte." >&2
        exit 1
    fi
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONF/hypr" "$CONF/vetro" "$HOME/.cache"
# i file di Hyprland dell'utente (Hyprland 0.57 legge solo Lua)
[ -f "$CONF/hypr/personale.lua" ] || cat > "$CONF/hypr/personale.lua" << 'FINE'
-- Le tue modifiche a Hyprland (le legge per ultime e vincono). Esempi:
--   hl.config({ decoration = { rounding = 8 } })
--   hl.bind("SUPER + T", hl.dsp.exec_cmd("foot"))
-- Dopo una modifica:  hyprctl reload
FINE
[ -f "$CONF/hypr/vetro-impostazioni.lua" ] || cp /etc/xdg/hypr/vetro-impostazioni.lua "$CONF/hypr/vetro-impostazioni.lua"
# app GTK chiare con l'accento blu: il CSS di Vetro si copia se manca o se e' ancora
# quello di Vetro (stessa prima riga); un gtk.css tuo non si tocca
CSS="${VETRO_CSS:-/etc/xdg/vetro}"
for v in 3.0 4.0; do
    dest="$CONF/gtk-$v/gtk.css"
    if [ ! -f "$dest" ] || head -n 1 "$dest" | grep -q '^/\* Vetro (creato da vetro-arch.sh)'; then
        mkdir -p "$CONF/gtk-$v"
        cp -f "$CSS/gtk-$v.css" "$dest" 2>/dev/null
    fi
done
# risoluzione di partenza: nelle macchine virtuali 1920x1080 (all'accensione QEMU
# propone spesso 800x600). Quella scelta in Impostazioni -> Schermo vale su tutte
# (e' scritta dopo, in vetro-impostazioni.lua)
if systemd-detect-virt -q 2>/dev/null; then
    echo 'hl.monitor({ output = "", mode = "1920x1080", position = "auto", scale = "1" })' > "$CONF/hypr/vetro-schermo.lua"
else
    echo "-- su un PC vero: la risoluzione migliore dello schermo (vetro.lua)" > "$CONF/hypr/vetro-schermo.lua"
fi
if [ -f "$HOME/.cache/hyprland.log" ]; then mv -f "$HOME/.cache/hyprland.log" "$HOME/.cache/hyprland-prima.log"; fi
# le scelte di oversicaOS per Caelestia (solo quelle che mancano)
oversica-config || true
exec Hyprland -c /etc/xdg/hypr/vetro.lua > "$HOME/.cache/hyprland.log" 2>&1
