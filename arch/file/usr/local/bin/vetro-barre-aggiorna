#!/bin/bash
# Barre del titolo delle finestre (creato da lfs.sh): compila il plugin hyprbars per la
# versione di Hyprland installata, con lo stesso metodo di hyprpm (il file hyprpm.toml
# degli autori dice quale versione del plugin va con quale Hyprland; per una versione di
# Hyprland che non c'e' ancora nell'elenco si usa l'ultima versione del plugin).
# Lo lancia lfs.sh e, dopo ogni aggiornamento di Hyprland, pacman (hook).
#   vetro-barre-aggiorna                        compila e scrive /etc/xdg/hypr/vetro-barre.lua
#   vetro-barre-aggiorna --commit-per VER FILE  solo il commit del plugin per Hyprland VER
# Se qualcosa non va le barre mancano, ma non e' un errore: il desktop funziona lo stesso.
set -euo pipefail
RADICE=${VETRO_RADICE:-}
CONF="$RADICE/etc/xdg/hypr/vetro-barre.lua"
PLUGIN="$RADICE/usr/lib/hyprland-plugins/hyprbars.so"
REPO=https://github.com/hyprwm/hyprland-plugins

# commit_per VERSIONE FILE: il secondo commit della riga che finisce con "# VERSIONE"
commit_per() {
    local riga
    riga=$(grep -E "\][[:space:]]*,?[[:space:]]*#[[:space:]]*${1//./\\.}[[:space:]]*$" "$2" | tail -n 1) || return 1
    printf '%s\n' "$riga" | grep -oE '"[0-9a-f]{7,40}"' | sed -n '2p' | tr -d '"' | grep . || return 1
}

senza_barre() {
    mkdir -p "$(dirname "$CONF")"
    echo "-- Barre del titolo: non ci sono ($1)" > "$CONF"
    echo "[!!] Barre del titolo: $1" >&2
    exit 0
}

if [ "${1:-}" = --commit-per ]; then
    commit_per "$2" "$3"
    exit
fi

versione=$(pacman -Q hyprland 2>/dev/null | awk '{print $2}' | cut -d- -f1)
[ -n "$versione" ] || senza_barre "Hyprland non e' installato"
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
# l'ultima versione del plugin (con dentro l'elenco hyprpm.toml)
scarica_main() {
    curl -fsSL --retry 3 -o "$t/main.tar.gz" "$REPO/archive/refs/heads/main.tar.gz" \
        || senza_barre "non riesco a scaricare il plugin"
    tar -xzf "$t/main.tar.gz" -C "$t"
}
toml=${VETRO_HYPRPM_TOML:-}
if [ -z "$toml" ]; then
    scarica_main
    toml="$t/hyprland-plugins-main/hyprpm.toml"
fi
if commit=$(commit_per "$versione" "$toml"); then
    curl -fsSL --retry 3 -o "$t/plugin.tar.gz" "$REPO/archive/$commit.tar.gz" \
        || senza_barre "non riesco a scaricare il plugin"
    tar -xzf "$t/plugin.tar.gz" -C "$t"
    sorgente="$t/hyprland-plugins-$commit"
else
    echo "Barre del titolo: per Hyprland $versione uso l'ultima versione del plugin"
    [ -d "$t/hyprland-plugins-main" ] || scarica_main
    sorgente="$t/hyprland-plugins-main"
fi
make -C "$sorgente/hyprbars" all >"$t/make.log" 2>&1 \
    || { tail -n 20 "$t/make.log" >&2; senza_barre "il plugin non si compila per Hyprland $versione"; }
install -Dm755 "$sorgente/hyprbars/hyprbars.so" "$PLUGIN"
cat > "$CONF" << "FINE"
-- Barre del titolo delle finestre (creato da lfs.sh): plugin hyprbars, chiare con il
-- titolo al centro e i tasti scuri a destra. Hyprland 0.57 legge solo Lua.
-- Trascina la barra per spostare la finestra, doppio clic per ingrandirla.
-- Pulsanti a destra: chiudi, ingrandisci, riduci.
-- Per toglierle: in ~/.config/hypr/personale.lua scrivi
--   hl.config({ plugin = { hyprbars = { enabled = false } } })
hl.plugin.load("/usr/lib/hyprland-plugins/hyprbars.so")

-- Hyprland carica il plugin dopo aver letto i file e poi li rilegge: solo alla seconda
-- lettura ci sono le opzioni e i pulsanti del plugin
if rawget(hl.plugin, "hyprbars") then
    local ingrandisci = [[hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" })']]
    hl.config({
        plugin = {
            hyprbars = {
                bar_height = 34,
                bar_color = "rgba(f6f8fbff)",
                col = { text = "rgba(15181dff)" },
                bar_text_font = "DM Sans",
                bar_text_size = 12,
                bar_text_align = "center",
                bar_part_of_window = true,
                bar_precedence_over_border = true,
                bar_buttons_alignment = "right",
                bar_padding = 10,
                bar_button_padding = 8,
                inactive_button_color = "rgba(00000000)",
                on_double_click = ingrandisci,
            },
        },
    })
    -- il primo pulsante e' il piu' a destra
    local function pulsante(simbolo, comando)
        hl.plugin.hyprbars.add_button({ bg_color = "rgba(00000000)", fg_color = "rgba(15181dff)",
                                        size = 22, icon = simbolo, action = comando })
    end
    pulsante("✕", "hyprctl dispatch 'hl.dsp.window.close()'")
    pulsante("■", ingrandisci)
    pulsante("–", [[hyprctl dispatch 'hl.dsp.window.move({ workspace = "special:ridotte", follow = false })']])
end
FINE
echo "[OK] Barre del titolo pronte (plugin per Hyprland $versione)"
