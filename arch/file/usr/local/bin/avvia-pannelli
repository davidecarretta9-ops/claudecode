#!/bin/bash
# La grafica di oversicaOS (creato da lfs.sh): Caelestia (Quickshell, in
# /etc/xdg/quickshell/caelestia). Se si chiude per un errore riparte; se si blocca (non
# risponde per circa 15 secondi) lo chiude e riparte; se continua a non partire avvisa
# e riprova ogni 30 secondi. Il motivo e' in ~/.cache/quickshell-vetro.log
export PATH="/usr/local/bin:$PATH"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORM=wayland
registro="$HOME/.cache/quickshell-vetro.log"
OGNI=${VETRO_OGNI:-5}       # secondi tra un controllo e l'altro (le prove lo accorciano)
mkdir -p "$HOME/.cache"

# i pannelli sono caricati? (rispondono solo se tutti i file si sono caricati bene;
# se Quickshell e' bloccato la domanda resta senza risposta: dopo 4 secondi e' un no)
risponde() {
    [ "$(timeout 4 qs -c caelestia ipc call oversica ping 2>/dev/null)" = ok ]
}

# Quickshell bloccato: si scrive nel registro cosa stava facendo, poi si chiude
bloccati() {
    local pid=$1 f
    {
        echo "--- $(date '+%F %T') i pannelli non rispondono: li chiudo e li riapro"
        grep '^State' "/proc/$pid/status" 2>/dev/null
        for f in /proc/"$pid"/task/*; do
            [ -d "$f" ] || continue
            echo "  filo ${f##*/} $(cat "$f/comm" 2>/dev/null): $(cat "$f/wchan" 2>/dev/null) $(cut -d' ' -f1 "$f/syscall" 2>/dev/null)"
        done
        if timeout 3 hyprctl version >/dev/null 2>&1; then echo "  Hyprland risponde"
        else echo "  Hyprland NON risponde"; fi
    } >> "$registro" 2>&1
    kill -KILL "$pid" 2>/dev/null
}

# aspetta che Quickshell si chiuda; se smette di rispondere 3 volte di fila lo chiude
sorveglia() {
    local pid=$1 mancati=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep "$OGNI"
        kill -0 "$pid" 2>/dev/null || break
        if risponde; then mancati=0; else mancati=$(( mancati + 1 )); fi
        if [ "$mancati" -ge 3 ]; then
            bloccati "$pid"
            ( sleep 10; notify-send "oversicaOS" "I pannelli si erano bloccati: li ho riaperti" ) >/dev/null 2>&1 &
            break
        fi
    done
    wait "$pid" 2>/dev/null
}

errori_rapidi=0
while :; do
    inizio=$SECONDS
    echo "--- $(date '+%F %T') avvio" >> "$registro"
    quickshell -c caelestia >> "$registro" 2>&1 &
    pid=$!
    caricati=0
    for _ in $(seq 1 20); do
        sleep 1
        kill -0 "$pid" 2>/dev/null || break
        if risponde; then caricati=1; break; fi
    done
    if [ "$caricati" = 1 ]; then
        sorveglia "$pid"
        esito=$?
    else
        echo "--- $(date '+%F %T') i pannelli non rispondono" >> "$registro"
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        esito=1
    fi
    # chiusa con "Esci" da Hyprland: Hyprland non c'e' piu', si esce anche qui
    pgrep -x Hyprland >/dev/null || exit 0
    if [ "$caricati" = 0 ]; then
        errori_rapidi=$(( errori_rapidi + 2 ))     # non si caricano: si riprova una volta sola
    elif [ $(( SECONDS - inizio )) -lt 15 ]; then
        errori_rapidi=$(( errori_rapidi + 1 ))
    else
        errori_rapidi=0
    fi
    echo "--- $(date '+%F %T') chiusa (codice $esito)" >> "$registro"
    if [ "$errori_rapidi" -ge 3 ]; then
        echo "--- $(date '+%F %T') non partono: riprovo tra 30 secondi" >> "$registro"
        notify-send -u critical "oversicaOS" "I pannelli non partono: riprovo tra poco. Il motivo e' in ~/.cache/quickshell-vetro.log" 2>/dev/null
        sleep 30
        errori_rapidi=0
    fi
    sleep 1
done
