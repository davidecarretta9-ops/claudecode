#!/usr/bin/python3 -I
# Il Wi-Fi per il centro di controllo (creato da vetro-arch.sh). Parla con iwd
# attraverso iwctl.
#   vetro-wifi elenco                  le reti vicine, in JSON, la piu' forte prima
#   vetro-wifi collega NOME [PASSWORD] si collega (senza password: rete aperta o gia' salvata)
#   vetro-wifi scollega                si scollega
# Esce con 0 se e' andata bene, 1 se no (il motivo e' scritto su stderr).
import json
import os
import re
import subprocess
import sys

ANSI = re.compile(r"\x1b\[[0-9;]*m")
# una riga dell'elenco, senza colori: [>] NOME  SICUREZZA  SEGNALE
RIGA = re.compile(r"^\s*(>\s+)?(.*?)\s+(\S+)\s+(\S+)\s*$")
# le stelline del segnale: quelle accese vengono prima del colore grigio
STELLE = re.compile(r"(\*+)(?:\x1b\[[0-9;]*m\**)?(?:\x1b\[[0-9;]*m)?\s*$")
SEPARATORE = re.compile(r"^-{10,}$")


def da_dbm(valore):
    """Il segnale in dBm (anche x100, come lo da' iwd) in tacche da 1 a 4."""
    dbm = int(valore)
    if abs(dbm) > 200:
        dbm = dbm / 100
    if dbm >= -60:
        return 4
    if dbm >= -67:
        return 3
    if dbm >= -75:
        return 2
    return 1


def leggi_elenco(testo):
    """Il testo di "iwctl station DISPOSITIVO get-networks" -> lista di reti."""
    reti = []
    separatori = 0
    for grezza in testo.splitlines():
        pulita = ANSI.sub("", grezza).rstrip()
        if SEPARATORE.match(pulita.strip()):
            separatori += 1
            continue
        if separatori < 2 or not pulita.strip():
            continue
        m = RIGA.match(pulita)
        if not m:
            continue
        nome, sicurezza, segnale = m.group(2).strip(), m.group(3), m.group(4)
        if not nome:
            continue
        if re.fullmatch(r"-?\d+", segnale):
            tacche = da_dbm(segnale)
        else:
            s = STELLE.search(grezza.rstrip())
            tacche = len(s.group(1)) if s else segnale.count("*")
        reti.append({
            "nome": nome,
            "segnale": max(0, min(4, tacche)),
            "protetta": sicurezza != "open",
            "collegata": m.group(1) is not None,
        })
    reti.sort(key=lambda r: (not r["collegata"], -r["segnale"]))
    return reti


def dispositivo():
    """La prima scheda Wi-Fi (quella con la cartella "wireless"), o None."""
    base = "/sys/class/net"
    try:
        nomi = sorted(os.listdir(base))
    except OSError:
        return None
    for n in nomi:
        if os.path.isdir(os.path.join(base, n, "wireless")):
            return n
    return None


def iwctl(*argomenti, attesa=40):
    return subprocess.run(["iwctl", *argomenti], stdin=subprocess.DEVNULL,
                          capture_output=True, text=True, timeout=attesa)


def elenco(dev):
    if not dev:
        return []
    # si chiede una nuova ricerca: i risultati arrivano al giro dopo
    try:
        iwctl("station", dev, "scan", attesa=5)
    except (OSError, subprocess.SubprocessError):
        pass
    for chiesta in (["get-networks", "rssi-dbms"], ["get-networks"]):
        try:
            r = iwctl("station", dev, *chiesta, attesa=10)
        except (OSError, subprocess.SubprocessError):
            return []
        if r.returncode == 0:
            return leggi_elenco(r.stdout)
    return []


def principale(argomenti):
    if not argomenti or argomenti[0] not in ("elenco", "collega", "scollega"):
        print(__doc__ or "uso: vetro-wifi elenco | collega NOME [PASSWORD] | scollega", file=sys.stderr)
        return 1
    dev = dispositivo()
    if argomenti[0] == "elenco":
        print(json.dumps(elenco(dev), ensure_ascii=False))
        return 0
    if not dev:
        print("Nessuna scheda Wi-Fi", file=sys.stderr)
        return 1
    try:
        if argomenti[0] == "scollega":
            r = iwctl("station", dev, "disconnect")
        elif len(argomenti) >= 3 and argomenti[2]:
            r = iwctl("--passphrase", argomenti[2], "station", dev, "connect", argomenti[1])
        elif len(argomenti) >= 2:
            r = iwctl("--dont-ask", "station", dev, "connect", argomenti[1])
        else:
            print("Manca il nome della rete", file=sys.stderr)
            return 1
    except (OSError, subprocess.SubprocessError) as e:
        print(f"iwctl non risponde: {e}", file=sys.stderr)
        return 1
    if r.returncode != 0:
        print(ANSI.sub("", (r.stderr or r.stdout).strip()) or "Non riesco a collegarmi", file=sys.stderr)
    return 0 if r.returncode == 0 else 1


if __name__ == "__main__":
    sys.exit(principale(sys.argv[1:]))
