    "left_ptr_watch": ([lavoro(f) for f in range(8)], (0.6, 0.6), 70, ["progress", "half-busy"]),
    "sb_h_double_arrow": ([doppia(0)], (12, 12), 0,
                          ["h_double_arrow", "ew-resize", "col-resize", "left_side", "right_side",
