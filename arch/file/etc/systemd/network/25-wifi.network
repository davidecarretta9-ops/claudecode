# Rete Wi-Fi (creato da vetro-arch.sh): iwd si collega, systemd-networkd da' l'indirizzo.
# Niente DNS del router (si usa quello cifrato), il nome del computer non va al router.
[Match]
Name=wl*

[Network]
DHCP=yes
IgnoreCarrierLoss=3s
IPv6PrivacyExtensions=yes

[DHCPv4]
RouteMetric=600
UseDNS=no
SendHostname=no

[IPv6AcceptRA]
UseDNS=no
