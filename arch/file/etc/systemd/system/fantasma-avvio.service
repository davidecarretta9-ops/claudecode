[Unit]
Description=Modalita' fantasma: nome del computer e identificativo nascosti (vetro-arch.sh)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target systemd-networkd.service NetworkManager.service dbus.service sysinit.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fantasma-aiuto avvio

[Install]
WantedBy=sysinit.target
